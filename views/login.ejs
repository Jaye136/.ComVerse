<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Log in</title>
</head>

<body>
    <%- include ('partials/menu.ejs') %>
    <div class="body-ontop" style="width:550px">
        <div class="contents-userstuffs">
            <h1 style="margin-top:15px">Log in</h1>

            <% if (failed) { %>
                <p>No match found for given uuid-password pair.</p>
            <% } %>
            
            <form action="/login" method="post">
                <label for="uuid" style="margin-bottom:5px;">User authentication ID (8 characters)</label>
                <textarea id="uuid" name="uuid" minlength=8 maxlength=8 placeholder="UUID"
                    class="stiff-userpassfield needtext-no-ws" autocomplete="off"
                    required><%= wrongUUID %></textarea>
                <label for="pass" style="margin-bottom:5px;">Password (max 12 characters)</label>
                <textarea id="pass" name="pass" maxlength=12 placeholder="Password"
                    class="stiff-userpassfield needtext-no-ws" style="-webkit-text-security:disc;"
                    autocomplete="off" required></textarea>

                <button type="submit" style="bottom:50px; font-family:inherit; height:40px;">Log in</button>
            </form>
            <br>
            <p>New user? Signup <a href="/signup">here</a></p>
        </div>
    <div class="body-ontop">

    <script src="/needtext.js"></script>
</body>

</html>
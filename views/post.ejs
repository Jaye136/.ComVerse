<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title><%= post.title %></title>
</head>

<body>
    <%- include ('partials/menu.ejs') %>
    <div class="contents">
        <h1 style="margin-bottom:0px"><%= post.title %></h1>
        <div class="compost-sidetoside">
        <p style="margin-top:15px;"><%= post.timestamp.toLocaleString(undefined, {
            timeStyle: 'short',
            dateStyle: 'medium'
        }) %></p>
        <h3 style="margin-top:15px;"><%= poster %></h3>
        </div>
        <p style="padding-left:40px; margin-top:25px; margin-bottom:35px"><%= post.contents %></p>

        <hr>
        
        <h2>Comments</h2>
        <% if (!currUser) { %>
            <p><a href="/login">Log in</a> to add a comment.</p>
        <% } else { %>
            <form action="/posts/<%= post.id %>" method="post">
                <div class="compost-sidetoside">
                    <label for="comment" style="margin-bottom:5px; align-self:center; margin-bottom:30px;">
                        Comment (max 500 characters)</label>
                    <button type="submit" style="font-family:inherit; align-self:center; margin-bottom:30px;">
                        Add comment</button>
                </div>
                <textarea id="comment" name="comment" maxlength=500 placeholder="Add something to the conversation..."
                    class="stiff-commentfield needtext-no-startn" style="margin-bottom:5px;" autocomplete="off"
                    required></textarea>
                <input type="hidden" name="parent" value="<%= post.id %>"></input>
                <input type="hidden" name="parType" value="p"></input>
            </form>
        <% } %>

        <% if (commentChunks.length == 0) { %>
            <p style="margin-top:25px">No comments so far.</p>
        <% } else { %>
            <ul class="compost-list">
                <% commentChunks.forEach(commentBit => {
                    const topComment = commentBit[0][0];
                    const topAuthor = commentBit[0][1][0];
                    const nestComments = commentBit[1];
                %>
                    <li style="margin-bottom:20px">
                        <div class="compost-sidetoside">
                            <h3><%= topAuthor %></h3>
                            <p>
                                <%= topComment.timestamp.toLocaleString(undefined, {
                                    timeStyle: 'short',
                                    dateStyle: 'medium'
                                }) %>
                            </p>
                        </div>
                        <p style="margin-top:10px; margin-bottom:10px"><%= topComment.contents %></p>

                        <% if (nestComments.length > 0) { %>
                            <ul class="reply-reply-list">
                                <% nestComments.forEach(nestbit => {
                                    const nestComments = nestbit[0];
                                    const nestAuthor = nestbit[1][0];
                                %>
                                    <li class="reply-reply-item">
                                        <div class="compost-sidetoside">
                                            <h3><%= nestAuthor %></h3>
                                            <p>
                                                <%= nestComments.timestamp.toLocaleString(undefined, {
                                                    timeStyle: 'short',
                                                    dateStyle: 'medium'
                                                }) %>
                                            </p>
                                        </div>
                                        <p style="margin-top:10px; margin-bottom:-15px"><%= nestComments.contents %></p>
                                    </li>
                                <% })%>
                            </ul>
                        <% } %>
                    </li>
                <% }) %>
            </ul>
        <% } %>
    </div>
    <script src="/needtext.js"></script>
</body>

</html>
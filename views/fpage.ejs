<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Forum Homepage</title>
</head>

<body>
    <%- include ('partials/menu.ejs') %>
    <div class="contents">
        <h1>Forum Homepage</h1>
        <ul class="compost-list">
        <% postList.forEach(post => { %>
            <li>
                <div class="compost-sidetoside">
                <h2><a href="/posts/<%= post.id %>">
                    <%= (post.title.length > 30)? post.title.substring(0, 30) + '...' : post.title %></a></h2>
                <p><%= post.timestamp.toLocaleString(undefined, {
                    timeStyle: 'short',
                    dateStyle: 'medium'
                }) %></p>
                </div>
                <% if (post.status == 'active') { %>
                    <p><%= (post.contents.length > 200)? post.contents.substring(0, 200) + '...' : post.contents %></p>
                <% } else if (post.status == 'deleted' && authCheck) { %>
                    <p style="color:rgb(132, 132, 132);">Deleted post:
                        <%= (post.contents.length > 200)? post.contents.substring(0, 200) + '...' : post.contents %></p>
                <% } else { %>
                    <p style="color:rgb(132, 132, 132);">[Post has been deleted]</p>
                <% } %>
            </li>
        <% }) %>
        </ul>
    </div>
    <% if (canLoadMore) { %>
        <div class="loadmore" style="display:flex;">
            <form action="/posts" method="post">
                <button type="submit" style="width:100px; height:30px;">Load more ▼</button>
            </form>
        </div>
    <% }%>
</body>

</html>